{
    "manifest_version": 3,
    "name": "PDF Watermark Manager",
    "version": "1.0",
    "description": "Remove and replace watermarks in PDFs via Side Panel.",
    "permissions": [
        "sidePanel"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "lib/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}